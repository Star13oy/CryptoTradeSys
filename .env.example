FUNDING_ARB_APP_MODE=paper
FUNDING_ARB_EXCHANGE_NAME=binance
FUNDING_ARB_STORAGE_BACKEND=mysql
FUNDING_ARB_MYSQL_HOST=127.0.0.1
FUNDING_ARB_MYSQL_PORT=3306
FUNDING_ARB_MYSQL_USER=root
FUNDING_ARB_MYSQL_PASSWORD=root
FUNDING_ARB_MYSQL_DATABASE=crypto_funding_arb
FUNDING_ARB_LIVE_EXECUTION_ENABLED=false
FUNDING_ARB_LIVE_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT
FUNDING_ARB_MAX_LIVE_NOTIONAL=25000
FUNDING_ARB_LIVE_CIRCUIT_BREAKER_ENABLED=true
FUNDING_ARB_LIVE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=2
FUNDING_ARB_LIVE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
FUNDING_ARB_RECONCILIATION_WORKER_ENABLED=false
FUNDING_ARB_RECONCILIATION_WORKER_INTERVAL_SECONDS=30
FUNDING_ARB_RECONCILIATION_WORKER_LIMIT=5
FUNDING_ARB_RECOVERY_WORKER_ENABLED=false
FUNDING_ARB_RECOVERY_WORKER_INTERVAL_SECONDS=30
FUNDING_ARB_RECOVERY_WORKER_LIMIT=3
FUNDING_ARB_COMPENSATION_WORKER_ENABLED=false
# Compensation worker uses the interval/limit knobs below to poll only safe, allowlisted actions.
FUNDING_ARB_COMPENSATION_WORKER_INTERVAL_SECONDS=30
FUNDING_ARB_COMPENSATION_WORKER_LIMIT=3
# Exposure limit for compensation worker runs; used to keep rebalance actions within guardrails.
FUNDING_ARB_COMPENSATION_WORKER_EXPOSURE_LIMIT_BPS=50
